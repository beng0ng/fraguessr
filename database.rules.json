{
  "rules": {
    "daily": {
      "$date": {
        ".read": "$date.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
        "n": {
          ".write": "auth != null && !root.child('subs/' + $date + '/' + auth.uid).exists() && newData.parent().parent().parent().child('subs/' + $date + '/' + auth.uid).val() === true",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "notes": {
          "$id": {
            ".write": "auth != null && !root.child('subs/' + $date + '/' + auth.uid).exists() && newData.parent().parent().parent().parent().child('subs/' + $date + '/' + auth.uid).val() === true",
            ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        },
        "score": {
          "$k": {
            ".write": "auth != null && !root.child('subs/' + $date + '/' + auth.uid).exists() && newData.parent().parent().parent().parent().child('subs/' + $date + '/' + auth.uid).val() === true",
            ".validate": "$k.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "subs": {
      "$date": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "$date.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && newData.val() === true"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "save": {
          ".validate": "newData.hasChildren(['json', 'at']) && newData.child('json').isString() && newData.child('json').val().length < 4000000 && newData.child('at').isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && $key.beginsWith(auth.uid + '_')",
        ".validate": "newData.isString() && newData.val().length < 2000"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".validate": "$room.matches(/^fg-[a-z0-9]{4}$/)",
        "$key": {
          ".write": "auth != null && $key.beginsWith(auth.uid + '_')",
          ".validate": "newData.isString() && newData.val().length < 20000"
        }
      }
    },
    "ladder": {
      ".read": "auth != null",
      ".indexOn": [
        "r"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['r', 'nm', 'col', 'n', 'w', 't']) && newData.child('r').isNumber() && newData.child('r').val() >= 0 && newData.child('r').val() <= 4000 && newData.child('nm').isString() && newData.child('nm').val().length <= 18 && newData.child('col').isString() && newData.child('col').val().matches(/^#[0-9a-fA-F]{6}$/) && newData.child('n').isNumber() && newData.child('w').isNumber() && newData.child('w').val() <= newData.child('n').val() && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000",
        "$other": {
          ".validate": "$other === 'r' || $other === 'nm' || $other === 'col' || $other === 'n' || $other === 'w' || $other === 't'"
        }
      }
    },
    "ghosts": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['t', 'j']) && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000 && newData.child('j').isString() && newData.child('j').val().length < 3000",
        "$other": {
          ".validate": "$other === 't' || $other === 'j'"
        }
      }
    }
  }
}
